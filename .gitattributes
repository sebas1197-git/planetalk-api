# Normalize line endings across platforms.
# Files in the repo are stored with LF; Git checks them out as-is.

# Default: treat as text and normalize to LF in the repository.
* text=auto eol=lf

# Explicit text files (always LF) — important for Linux containers & shell.
*.go        text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
Dockerfile* text eol=lf
Makefile    text eol=lf
.env*       text eol=lf
.gitignore  text eol=lf

# Binary files — never touch line endings.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.exe       binary
