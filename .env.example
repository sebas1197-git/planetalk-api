# Copy this file to ".env" and fill in real values. ".env" is git-ignored.

# --- HTTP server ---
APP_ENV=development
HTTP_PORT=8080

# --- PostgreSQL ---
# When running via docker-compose, host is "postgres" (the service name).
# When running the Go app on your machine against docker DB, use "localhost".
# NOTE: host port is 5434 (not 5432) to avoid the native Postgres already on 5432.
DATABASE_URL=postgres://planetalk:planetalk@localhost:5434/planetalk?sslmode=disable

# --- Redis ---
# NOTE: host port is 6380 (not 6379) to avoid another Redis already on 6379.
REDIS_URL=redis://localhost:6380/0

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- Twilio (OTP SMS) ---
# Leave blank in dev to use the console stub (OTP printed to logs).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Google Cloud Translation ---
# Simplest: create an API key in Google Cloud and put it here. Leave blank in
# dev -> messages are stored untranslated (stub pass-through).
GOOGLE_TRANSLATE_API_KEY=
# (Optional, for the service-account / v3 approach instead of an API key.)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TRANSLATE_PROJECT_ID=

# --- Agora (video) ---
# Get a free App ID + Certificate at https://console.agora.io (create a project
# with "Secured mode / APP ID + Token"). Leave blank in dev -> token endpoint
# returns 503 agora_not_configured.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=1h
